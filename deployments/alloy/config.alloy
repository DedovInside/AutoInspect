discovery.docker "autoinspect" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "autoinspect_logs" {
  targets = discovery.docker.autoinspect.targets

  rule {
    target_label = "job"
    replacement  = "autoinspect"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api|worker|ml-service|migrator"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "autoinspect" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.autoinspect_logs.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
