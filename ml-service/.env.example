KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=analysis.requested.v1
KAFKA_RESULT_TOPIC=analysis.completed.v1
KAFKA_CONSUMER_GROUP=autoinspect-ml-service
KAFKA_PRODUCE_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=500

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autoinspect
S3_DOWNLOAD_RETRIES=3
S3_DOWNLOAD_BACKOFF_SEC=1.0

LOCAL_CACHE_DIR=/tmp/autoinspect-cache

DAMAGE_MODEL_S3_KEY=models/general/damage_segmentation.pt
DAMAGE_CONFIG_S3_KEY=models/general/damage_inference_config.json

HEALTH_ENABLED=true
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8081
